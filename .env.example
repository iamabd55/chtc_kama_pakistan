# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (Resend)
RESEND_API_KEY=
# Must be a verified sender/domain in Resend (for example: no-reply@yourdomain.com)
