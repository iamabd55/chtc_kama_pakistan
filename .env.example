NOTIFICATION_FROM_EMAIL=noreply@alnasirmotors.com
# Admin inbox that receives all new inquiry notifications
SALES_NOTIFICATION_EMAIL=

# Cloudinary (video CDN for News & Events)
# Get these from: https://console.cloudinary.com → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional integrations
INQUIRY_WEBHOOK_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
